# Non-secret settings migrated from the attached Compose .env.
# Edit *.example.org addresses, API/browser URLs, DB names, and application options before deployment.
# Values with *_FILE refer to /run/secrets/<name> in the Kubernetes pods.
# The 19 secret VALUES must be installed separately; never paste them into this ConfigMap.
OSCB_APP_DATA_DIR=/data/oscb
OSCB_WORKER_DATA_DIR=/data/oscb
OSCB_NOTEBOOK_DATA_DIR=/data
OSCB_ADMIN_BIND_IP=127.0.0.1
OSCB_PUBLIC_BIND_IP=0.0.0.0
OSCB_WEB_WORKER_CONCURRENCY=2
OSCB_CPU_WORKER_CONCURRENCY=4
OSCB_CELERY_MAX_MEMORY_KB=100000000
HOST_URL=app.example.org
MONGO_URL=mongodb://mongodb:65530
UPLOAD_FOLDER=/data/upload
OUTPUT_FOLDER=/data/results
ERROR_FOLDER=/data/errors
REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_PORT=6388
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_PORT=5672
MYSQL_ROOT_PASSWORD_FILE=/run/secrets/mysql_password
MYSQL_DATABASE=oscb
MYSQL_TCP_PORT=3308
EXTERNAL_PORT=3001
DBUSER=root
DATABASE=oscb
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_ACCOUNT=notifications@example.org
EMAIL_PWD_FILE=/run/secrets/email_password
OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key
CONNECTION_LIMIT=25
COMPANION_UPLOAD_URLS=/.*/
GOOGLEDRIVE_KEY_FILE=/run/secrets/googledrive_key
GOOGLEDRIVE_SECRET_FILE=/run/secrets/googledrive_secret
DROPBOX_KEY_FILE=/run/secrets/dropbox_key
DROPBOX_SECRET_FILE=/run/secrets/dropbox_secret
ONEDRIVE_KEY_FILE=/run/secrets/onedrive_key
ONEDRIVE_SECRET_FILE=/run/secrets/onedrive_secret
NODE_ENV=development
MONGO_DB_NAME=oscb
MONGO_COLLECTION_OPTIONS=form_options
MONGO_COLLECTION_DATASETS=datasets
MONGO_COLLECTION_TASK_BUILDER=benchmarks
MONGO_COLLECTION_USER_DATASETS=user_datasets
MONGO_COLLECTION_JOBS=jobs
MONGO_COLLECTION_PREPROCESS_RESULTS=pp_results
MONGO_COLLECTION_BENCHMARKS=benchmarks
MONGO_COLLECTION_ERROR_LOG=error_log
MONGO_COLLECTION_PROJECTS=projects
MONGO_COLLECTION_CHAT_HISTORY=chat_history
NODE_MYSQL_CONNECTION_LIMIT=10
STORAGE_DIR=/usr/src/app/storage/
STORAGE_ALLOWANCE=50
INTERMEDIATE_STORAGE=/usr/src/app/temp/
PUBLIC_STORAGE=/usr/src/app/storage/publicDatasets/
REACT_APP_DIRECTUS_URL=https://directus.example.org
GITHUB_OWNER=cirisjl
GITHUB_REPO=single-cell.ai
GITHUB_TOKEN_FILE=/run/secrets/github_token
APP_ENV=Development
CELERY_BROKER_HOST=oscb-rabbitmq
CELERY_BROKER_USER=admin
CELERY_RESULT_BACKEND_HOST=oscb-redis
MAX_CONTENT_LENGTH=16000000
MAXCAPACITY=104857600
CORS_ENABLED=true
CORS_ORIGIN=https://app.example.org
CORS_METHODS=GET,POST,PATCH,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_EXPOSED_HEADERS=Content-Range
CORS_CREDENTIALS=true
CORS_MAX_AGE=18000
ME_CONFIG_MONGODB_URL=mongodb://mongodb:65530/
ME_CONFIG_MONGODB_SERVER=mongodb
ME_CONFIG_MONGODB_PORT=65530
ME_CONFIG_BASICAUTH_ENABLED=true
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD_FILE=/run/secrets/mongo_express_password
DB_CLIENT=mysql
DB_HOST=oscb-mysql
DB_PORT=3308
DB_DATABASE=oscb
DB_USER=root
DB_PASSWORD_FILE=/run/secrets/mysql_password
KEY_FILE=/run/secrets/directus_key
SECRET_FILE=/run/secrets/directus_secret
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD_FILE=/run/secrets/directus_password
PUBLIC_URL=https://directus.example.org
FLOWER_BASIC_AUTH_USER=admin
