# Prevent secrets/private host configuration from entering image builds.
.env
.env.*
secrets/*
!secrets/README.md
!secrets/.gitkeep
.git/
.gitignore
# Application build/runtime artifacts
**/node_modules/
**/.next/
**/build/
**/dist/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/.DS_Store
*.log
results/
uploads/
logs/
user_storage/
README.md
