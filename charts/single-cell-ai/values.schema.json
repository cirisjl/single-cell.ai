{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "workloads",
    "secrets",
    "storage",
    "config"
  ],
  "properties": {
    "secrets": {
      "type": "object",
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workloads": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "StatefulSet",
              "Deployment"
            ]
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "replicas": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "storage": {
      "type": "object"
    },
    "config": {
      "type": "object"
    },
    "ingress": {
      "type": "object"
    },
    "global": {
      "type": "object"
    }
  }
}
